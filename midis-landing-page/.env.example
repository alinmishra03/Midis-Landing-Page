# All optional — the site builds and runs without any of these.

# Existing MIDIS Strapi instance. Leads post here server-side only.
# Defaults to this value if unset; override to point at a staging CMS.
STRAPI_URL=https://jubilant-sparkle-2f7bfe100e.strapiapp.com

# Only needed if Strapi write access becomes token-gated.
# Read exclusively in app/api/enquiry/route.ts — never reaches the client.
STRAPI_API_TOKEN=

# Scheduling link for the confirmation pages.
# NOT YET SUPPLIED BY MIDIS. While unset, the thank-you pages show an
# email/WhatsApp fallback instead of a booking button — never a dead link,
# and never an implication that a meeting has been booked.
NEXT_PUBLIC_CALENDLY_URL=

# ---- Free Website Audit tool (/free-website-audit) ----
# All server-side only; none of these ever reach the browser.

# Google PageSpeed Insights API key (free: Google Cloud Console, enable the
# "PageSpeed Insights API", then Credentials). Without it the keyless quota
# is shared worldwide and routinely exhausted, so Lighthouse scores will
# usually be unavailable. The tool then reports a partial audit with page
# checks only; it never invents scores.
PAGESPEED_API_KEY=

# Encrypts the audit between step 1 and step 2. REQUIRED in production:
# any random string of 32+ characters (for example: openssl rand -hex 32).
AUDIT_TOKEN_SECRET=

# Resend (https://resend.com) emails the PDF report to the visitor.
# AUDIT_EMAIL_FROM must use a domain verified in Resend, for example
# "MIDIS <audit@midis.in>". Without these, the tool says the report could
# not be emailed and offers the PDF as a download instead.
RESEND_API_KEY=
AUDIT_EMAIL_FROM=

# Where the internal "new audit lead" notification goes. Not defaulted:
# if unset, no notification is sent (the lead is still stored in Strapi).
LEAD_NOTIFY_EMAIL=

# ---- "Before you go" consultation popup (/api/consultation) ----
# Admin Strapi that stores portfolio-consultations. Optional: defaults to
# https://admins.midis.in. A token is only needed if the collection's
# create permission is ever moved off the Public role.
MIDIS_ADMIN_API_URL=
MIDIS_ADMIN_API_TOKEN=
