# All optional — the site builds and runs without any of these.

# Existing MIDIS Strapi instance. Leads post here server-side only.
# Defaults to this value if unset; override to point at a staging CMS.
STRAPI_URL=https://jubilant-sparkle-2f7bfe100e.strapiapp.com

# Only needed if Strapi write access becomes token-gated.
# Read exclusively in app/api/enquiry/route.ts — never reaches the client.
STRAPI_API_TOKEN=

# Scheduling link for the confirmation pages.
# NOT YET SUPPLIED BY MIDIS. While unset, the thank-you pages show an
# email/WhatsApp fallback instead of a booking button — never a dead link,
# and never an implication that a meeting has been booked.
NEXT_PUBLIC_CALENDLY_URL=
